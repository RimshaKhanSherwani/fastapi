// Simulates the exact logic from StatusBanner.tsx's setTimeout callback

function buggyVersion(win) {
  const config = win.__APP_CONFIG__
  console.log(`Status banner running build ${config.buildId}`)
}

function fixedVersion(win) {
  const config = win.__APP_CONFIG__
  if (config) {
    console.log(`Status banner running build ${config.buildId}`)
  }
}

const fakeWindow = {} // __APP_CONFIG__ is never defined anywhere in the app

console.log("--- Testing buggy version (should throw) ---")
