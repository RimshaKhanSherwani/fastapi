  } else {
    console.log("FAIL: unexpected error:", err)
    process.exitCode = 1
  }
}

console.log("--- Testing fixed version (should NOT throw) ---")
try {
  fixedVersion(fakeWindow)
  console.log("PASS: fixed version did not throw")
} catch (err) {
  console.log("FAIL: fixed version threw:", err)
  process.exitCode = 1
}
