# Supabase project credentials (Project Settings -> API in the Supabase dashboard)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase service role key, used only by the Playwright test helper
# (frontend/tests/utils/privateApi.ts) to provision test users via the
# Supabase Admin API. Local/CI test use only - in CI it must come from a
# secret store, never a literal value. Never prefix with VITE_, or it would
# be bundled into the browser app.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
